[Unit]
Description=Pico DLNA Media Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit -name, -port, -path for your environment
ExecStart=/usr/local/bin/pico-dlna -name "Pico-DLNA" -port 1338 -path /opt/media
Restart=on-failure
RestartSec=5

# Optional: run as unprivileged user
# User=media
# Group=media

[Install]
WantedBy=multi-user.target
